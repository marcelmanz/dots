#!/usr/bin/env bash
# Set foot font size for a given output scale so effective px stays constant.
# Usage: set-font <scale>   (e.g. 2, 2.5, 1)

set -eu

scale="${1:?usage: set-font <scale>}"
out="${XDG_CONFIG_HOME:-$HOME/.config}/foot/font-active.ini"
# ponytail: target 20px effective everywhere; change TARGET to tune
TARGET=20
rm -f "$out"  # clear any stale symlink before writing a real file
printf 'font=Myna:size=%s\n' "$(awk "BEGIN{printf \"%g\", $TARGET/$scale}")" > "$out"
pkill -USR1 foot 2>/dev/null || true
