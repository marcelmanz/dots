# vim: set ft=kanshi:

profile home_office_work {
    output "HDMI-A-1" mode 3840x2160@60.00Hz position 4328,346 scale  1.666667
    output "DP-3"     mode 3840x2160@60.00Hz position 2020,346 scale  1.666667
    output "eDP-1"    disable
}

profile home_office {
    output "DP-2"     mode 3840x2160@60.00Hz position 0,0 scale  1.666667
    output "HDMI-A-1" mode 3840x2160@60.00Hz position 2304,0 scale  1.666667
    output "eDP-1"    disable
}

profile work {
    output "HDMI-A-1" mode 1920x1080@60.00Hz position 4328,346 scale  1
    output "eDP-1"    mode 1920x1200@60.00 position 0,0 scale 1.25
}

profile home_office_targus {
    output "DP-3"     mode 3840x2160@60.00Hz position 4328,346 scale  1.5
    output "DP-4"     mode 3840x2160@60.00Hz position 1768,346 scale  1.5
    output "eDP-1"    mode 3840x2160@60.01Hz position 6888,346 scale 2.4
    #output "eDP-1"    disable
}

profile laptop_only {
    output "eDP-1" mode 3840x2160@60.01Hz position 0,0 scale 2.5
    # output "eDP-1" mode 1920x1200@60.00 position 0,0 scale 1.25
}
