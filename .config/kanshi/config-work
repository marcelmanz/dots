# vim: set ft=kanshi:

profile home_office_work {
    # Formula to place outputs side by side:
    #   next_x = current_x + (mode_width / scale)
    #
    # HDMI-A-1:
    #   start_x = 2020
    #   width   = 3840 / 1.666667 ≈ 2304
    #   end_x   = 2020 + 2304 = 4324
    #
    # DP-3:
    #   start_x = 4324 (immediately after HDMI-A-1)
    #   width   = 3840 / 1.666667 ≈ 2304
    #   end_x   = 4324 + 2304 = 6628
    #
    # eDP-1:
    #   start_x = 6628 (immediately after DP-3)
    #   width   = 1920 / 1.25 = 1536
    #   end_x   = 6628 + 1536 = 8164
    #
    # All outputs share y=346 for vertical alignment.
    output "HDMI-A-1" mode 3840x2160@60.00Hz position 2020,346 scale 1.666667
    output "DP-3"     mode 3840x2160@60.00Hz position 4324,346 scale 1.666667
    #output "eDP-1"    mode 1920x1200@60.00   position 6628,346 scale 1.25
    output "eDP-1" disable
}

profile work {
    # berlin
    # output "HDMI-A-1" mode 1920x1080@60.00Hz position 1544,0 scale  1
    # output "eDP-1"    mode 1920x1200@60.00   position 0,120  scale 1.25

    # leipzig
    output "HDMI-A-1" mode 1920x1080@60.00Hz  position 1544,0    scale 1
    output "eDP-1"    mode 1920x1200@60.00    position 1544,1080 scale 1.25
}

profile home_office_targus {
    output "DP-3" mode 3840x2160@60.00Hz position 4328,346 scale  1.666667
    output "DP-4" mode 3840x2160@60.00Hz position 2020,346 scale  1.666667
    output "eDP-1" disable
}

profile home_office_targus_inverted {
    output "DP-5"  mode 3840x2160@60.00Hz position 4328,346  scale  1.666667
    output "DP-6"  mode 3840x2160@60.00Hz position 2020,346  scale  1.666667
    output "eDP-1" mode 3840x2160@60.01   position 2280,1498 scale 2.4
}

profile laptop_only {
    output "eDP-1" mode 1920x1200@60.00 position 0,0 scale 1.25
}

