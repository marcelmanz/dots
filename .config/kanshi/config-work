profile full_res_home_office {
    output "DP-3"     mode 3840x2160@60.00Hz position 0,346
    output "HDMI-A-1" mode 3840x2160@60.00Hz position 2560,346
    # output "eDP-1"    mode 1920x1200@60.00   position 0,120  scale 1.25
    output "eDP-1" disable
    exec ~/.config/foot/set-font 1
}

profile work {
    # berlin
    # output "HDMI-A-1" mode 1920x1080@60.00Hz position 1544,0 scale  1
    # output "eDP-1"    mode 1920x1200@60.00   position 0,120  scale 1.25

    # leipzig
    # output "HDMI-A-1" mode 1920x1080@60.00Hz  position 1544,0    scale 1
    # output "eDP-1"    mode 1920x1200@60.00    position 1544,1080 scale 1.25

    # office
    output "HDMI-A-1" mode 1920x1080@60.00Hz  position 3080,960    scale 1
    output "eDP-1"    mode 1920x1200@60.00    position 1544,1080   scale 1.5
    # output "eDP-1" disable
    exec ~/.config/foot/set-font 1
}

profile laptop_only {
    output "eDP-1" mode 1920x1200@60.00 position 0,0 scale 1
    exec ~/.config/foot/set-font 1
}

profile undocked {
    output "eDP-1" enable
    exec ~/.config/foot/set-font 1
}
