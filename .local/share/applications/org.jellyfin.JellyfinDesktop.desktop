[Desktop Entry]
Version=1.0
Name=Jellyfin
Comment=Desktop client for Jellyfin
# ponytail: QT_SCALE_FACTOR=1 so Qt doesn't stack on Hyprland's compositor scale.
# Global QT_SCALE_FACTOR=2 is for XWayland Qt (force_zero_scaling); jellyfin-desktop
# is Qt6 Wayland-native, where factor 2 = ~2x too big. Override to 1 here only.
Exec=env QT_SCALE_FACTOR=1 jellyfin-desktop
Icon=org.jellyfin.JellyfinDesktop
Terminal=false
Type=Application
StartupWMClass=org.jellyfin.JellyfinDesktop
Categories=AudioVideo;Video;Player;TV;

Actions=DesktopF;DesktopW;TVF;TVW

[Desktop Action DesktopF]
Name=Desktop [Fullscreen]
Exec=env QT_SCALE_FACTOR=1 jellyfin-desktop --fullscreen --desktop

[Desktop Action DesktopW]
Name=Desktop [Windowed]
Exec=env QT_SCALE_FACTOR=1 jellyfin-desktop --windowed --desktop

[Desktop Action TVF]
Name=TV [Fullscreen]
Exec=env QT_SCALE_FACTOR=1 jellyfin-desktop --fullscreen --tv

[Desktop Action TVW]
Name=TV [Windowed]
Exec=env QT_SCALE_FACTOR=1 jellyfin-desktop --windowed --tv
