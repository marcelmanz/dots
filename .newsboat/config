include ~/.newsboat/theme

browser xdg-open

unbind-key h
unbind-key j
unbind-key k
unbind-key l

bind-key h quit
bind-key j down
bind-key k up
bind-key l open

unbind-key g # bound to `sort` by default
bind-key g home
unbind-key G # bound to `rev-sort` by default
bind-key G end

urls-source "miniflux"
miniflux-url "https://exuberant-bird.pikapod.net/"
miniflux-token "`echo $MINI_FLUX_TOKEN`"
