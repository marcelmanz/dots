#!/usr/bin/env bash
set -euo pipefail

step=0.05
minimum=0.10
fallback_restore=0.80
theme=$HOME/.cache/alacritty-theme.toml
state=$HOME/.cache/alacritty-opacity
restore=$HOME/.cache/alacritty-opacity-restore

theme_opacity=$(awk -F' *= *' '/^opacity/ {print $2; exit}' "$theme" 2>/dev/null || true)
theme_opacity=${theme_opacity:-1.0}

current=$theme_opacity
if [[ -f $state && $state -nt $theme ]]; then current=$(< "$state"); fi

apply() {
  printf '%s\n' "$1" > "$state"
  for socket in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/Alacritty-*.sock; do
    [[ -S $socket ]] || continue
    alacritty msg --socket "$socket" config -w -1 "window.opacity=$1" || true
  done
}

case ${1:-} in
  up)
    apply "$(awk -v o="$current" -v s="$step" 'BEGIN { o += s; if (o > 1) o = 1; printf "%.2f", o }')"
    ;;
  down)
    apply "$(awk -v o="$current" -v s="$step" -v m="$minimum" 'BEGIN { o -= s; if (o < m) o = m; printf "%.2f", o }')"
    ;;
  toggle)
    if awk -v o="$current" 'BEGIN { exit !(o < 1) }'; then
      printf '%s\n' "$current" > "$restore"
      apply 1.00
    else
      apply "$(cat "$restore" 2>/dev/null || echo "$fallback_restore")"
    fi
    ;;
  *)
    echo "usage: ${0##*/} up|down|toggle" >&2
    exit 2
    ;;
esac
