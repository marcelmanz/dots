#!/usr/bin/env bash
set -euo pipefail

own_socket=${ALACRITTY_SOCKET:?run from an Alacritty key binding}
alacritty_pid=${own_socket%.sock}
alacritty_pid=${alacritty_pid##*-}
request_dir=${XDG_RUNTIME_DIR:-/run/user/$UID}/alacritty-tmux

notify() {
  notify-send -a alacritty tmux "$1"
}

is_descendant_of_alacritty() {
  local pid=$1
  while [[ -n $pid && $pid -gt 1 ]]; do
    [[ $pid == "$alacritty_pid" ]] && return 0
    pid=$(ps -o ppid= -p "$pid" | tr -d ' ')
  done
  return 1
}

if tmux list-clients >/dev/null 2>&1; then
  while read -r client_pid client_session; do
    if is_descendant_of_alacritty "$client_pid"; then
      notify "Already in tmux session $client_session"
      exit 0
    fi
  done < <(tmux list-clients -F '#{client_pid} #{session_name}')
fi

read -r shell_pid fg_pgid < <(ps -o pid=,tty=,tpgid= --ppid "$alacritty_pid" | awk '$2 != "?" { print $1, $3; exit }')
read -r name _ < <(ps -o args= -p "$fg_pgid")
name=${name##*/}
name=${name#-}
name=${name//[.:]/-}
session=$name-$fg_pgid
cwd=$(readlink "/proc/$fg_pgid/cwd")
request=$request_dir/$shell_pid

mkdir -p "$request_dir"

if [[ $fg_pgid == "$shell_pid" ]]; then
  tmux new-session -d -s "$session" -c "$cwd"
  printf '%s\n' "$session" > "$request"
  hyprctl dispatch "hl.dsp.send_shortcut({ mods = \"CTRL\", key = \"c\", window = \"pid:$alacritty_pid\" })" >/dev/null
  exit 0
fi

claude_registry=$HOME/.claude/sessions/$fg_pgid.json
if [[ $name == claude && -f $claude_registry ]]; then
  claude_session_id=$(jq -r .sessionId "$claude_registry")
  claude_title=$(grep -h '"type":"ai-title"' "$HOME"/.claude/projects/*/"$claude_session_id".jsonl 2>/dev/null | tail -1 | jq -r .aiTitle || true)
  claude_slug=$(tr '[:upper:]' '[:lower:]' <<< "$claude_title" | tr -cs 'a-z0-9' '-' | cut -c1-40 | sed 's/^-*//; s/-*$//')
  if [[ -n $claude_slug ]] && ! tmux has-session -t "=claude_$claude_slug" 2>/dev/null; then
    session=claude_$claude_slug
  fi
  tmux new-session -d -s "$session" -c "$cwd" \
    "tail --pid=$fg_pgid -f /dev/null; claude --resume $claude_session_id; exec \"\$SHELL\""
  printf '%s\n' "$session" > "$request"
  kill -TERM "$fg_pgid"
  exit 0
fi

if ! command -v reptyr >/dev/null; then
  notify "Install reptyr to move $name into tmux"
  exit 1
fi

if [[ $(< /proc/sys/kernel/yama/ptrace_scope) != 0 ]]; then
  notify "Can't move $name: needs kernel.yama.ptrace_scope=0"
  exit 1
fi

if (( $(pgrep -c -g "$fg_pgid") > 1 )); then
  notify "Can't move $name: it has child processes"
  exit 1
fi

if ls -l "/proc/$fg_pgid/fd" 2>/dev/null | grep -q 'anon_inode:\[eventpoll\]' &&
  stty -F "$(readlink "/proc/$fg_pgid/fd/0")" -a | grep -q -- '-icanon'; then
  notify "Can't move $name: full-screen app that wouldn't get your keys after the move"
  exit 1
fi

printf '%s %s\n' "$session" "$fg_pgid" > "$request"
tmux new-session -d -s "$session" -c "$cwd" \
  "reptyr $fg_pgid && exec \"\$SHELL\"; rm -f '$request'; notify-send -a alacritty tmux 'reptyr could not move $name'"
