#!/usr/bin/env bash
set -euo pipefail

own_socket=${ALACRITTY_SOCKET:?run from an Alacritty key binding}
alacritty_pid=${own_socket%.sock}
alacritty_pid=${alacritty_pid##*-}

is_descendant_of_alacritty() {
  local pid=$1
  while [[ -n $pid && $pid -gt 1 ]]; do
    [[ $pid == "$alacritty_pid" ]] && return 0
    pid=$(ps -o ppid= -p "$pid" | tr -d ' ')
  done
  return 1
}

if command -v tmux >/dev/null && tmux list-clients >/dev/null 2>&1; then
  while read -r client_pid client_name; do
    if is_descendant_of_alacritty "$client_pid"; then
      pane_id=$(tmux display-message -c "$client_name" -p '#{pane_id}')
      exec tmux copy-mode -t "$pane_id"
    fi
  done < <(tmux list-clients -F '#{client_pid} #{client_name}')
fi

exec hyprctl dispatch 'hl.dsp.send_shortcut({ mods = "CTRL SHIFT", key = "space", window = "activewindow" })'
