#!/usr/bin/env bash

flake_dir="$HOME/.config/nix"
hms_target="work"
nixos_target="nixos"
quickshell_config="$HOME/.config/quickshell/nixbuild"
log_file="${XDG_STATE_HOME:-$HOME/.local/state}/nixbuild/last-build.log"

progress_program='
def pretty: sub("^/nix/store/[a-z0-9]{32}-"; "") | sub("\\.drv$"; "");
def short: if length > 90 then .[0:90] else . end;
def key($event): $event.id | tostring;

def step($event):
	if $event.action == "start" then
		.kinds[key($event)] = $event.type
		| if $event.type == 105 then
			.builds[key($event)] = ($event.fields[0] | pretty) | .phase = "building"
		elif $event.type == 108 then
			.fetches[key($event)] = ($event.fields[0] | pretty) | .phase = "building"
		else . end
	elif $event.action == "stop" then
		del(.builds[key($event)], .fetches[key($event)])
	elif $event.action == "result" then
		if $event.type == 105 and (.kinds[key($event)] | IN(103, 104)) then
			.progress[key($event)] = $event.fields[0:2]
		elif $event.type == 101 then
			.line = ($event.fields[0] | short)
		else . end
	else . end;

def summary:
	(.progress | to_entries | map(.value)) as $counts
	| (.builds | to_entries | map(.value)) as $builds
	| (.fetches | to_entries | map(.value)) as $fetches
	| {
		phase,
		line,
		cancellable: (.phase != "activating"),
		label: (
			if ($builds | length) > 0 then
				"building " + $builds[-1] + (if ($builds | length) > 1 then " +\(($builds | length) - 1)" else "" end)
			elif ($fetches | length) > 0 then
				"fetching " + $fetches[-1]
			elif .phase == "activating" then .plain
			elif .phase == "building" then "finishing"
			else "evaluating configuration" end
		),
		done: ($counts | map(.[0]) | add // 0),
		total: ($counts | map(.[1]) | add // 0)
	};

foreach inputs as $raw (
	{kinds: {}, builds: {}, fetches: {}, progress: {}, phase: "evaluating", line: "", plain: "", last: null};
	(if ($raw | startswith("@nix ")) then ($raw[5:] | fromjson? // null) else $raw end) as $event
	| if $event == null then .
	elif ($event | type) == "string" then
		if ($event | test("\\S")) and ($event | test("news") | not) then
			.phase = "activating" | .plain = ($event | short)
		else . end
	else step($event) end
	| summary as $current
	| .changed = ($current != .last)
	| .last = $current;
	select(.changed) | {state: "building"} + .last
)
'

failure_program='
if startswith("@nix ") then
	.[5:] | fromjson? // empty
	| if .action == "msg" and .level == 0 then .msg
	elif .action == "result" and .type == 101 then .fields[0]
	else empty end
else . end
'

log_program='
if startswith("@nix ") then
	.[5:] | fromjson? // empty
	| if .action == "msg" and .level <= 3 then .msg
	elif .action == "start" and .level <= 3 and .text != "" then .text
	elif .action == "result" and .type == 101 then .fields[0]
	else empty end
else . end
'

is_nixos() {
	[ -e /etc/NIXOS ]
}

resolve_ssh_target() {
	local candidate
	for candidate in "root@$1-local" "root@$1"; do
		if ssh -q -o ConnectTimeout=5 -o BatchMode=yes "$candidate" exit 2>/dev/null; then
			echo "$candidate"
			return
		fi
	done
	return 1
}

emit_final() {
	jq -cn --arg state "$1" --argjson seconds "$2" --arg error "$3" \
		'{state: $state, seconds: $seconds, error: $error}'
}

info() {
	local host=$1 kind="hms" target="home-manager · $hms_target"
	if [ -n "$host" ]; then
		kind="deploy"
		target="deploy · $host"
	elif is_nixos; then
		kind="ns"
		target="nixos · $nixos_target"
	fi
	git -C "$flake_dir" status --porcelain | jq -Rcn --arg host "$host" --arg kind "$kind" --arg target "$target" '
		[inputs | {status: (.[0:2] | gsub(" "; "") | .[0:1]), path: .[3:]}] as $files
		| {
			host: $host,
			kind: $kind,
			target: $target,
			files: $files,
			untracked: ($files | map(select(.status == "?")) | length)
		}'
}

check() {
	local host=$1 err result active generation builds fetches error ssh_target
	local attr="homeConfigurations.$hms_target.activationPackage"
	local profile="$HOME/.local/state/nix/profiles/home-manager"
	if [ -n "$host" ]; then
		attr="nixosConfigurations.$host.config.system.build.toplevel"
	elif is_nixos; then
		attr="nixosConfigurations.$nixos_target.config.system.build.toplevel"
		profile=/run/current-system
	fi

	err=$(mktemp)
	if ! result=$(nix build --dry-run --json "$flake_dir#$attr" 2>"$err"); then
		error=$(sed 's/\x1b\[[0-9;]*m//g' "$err" | grep -m1 'error:')
		rm -f "$err"
		jq -cn --arg host "$host" --arg error "$error" '{host: $host, checked: true, error: $error}'
		return
	fi

	generation=$(jq -r '.[0].outputs.out' <<<"$result")
	if [ -n "$host" ]; then
		if ! ssh_target=$(resolve_ssh_target "$host"); then
			rm -f "$err"
			jq -cn --arg host "$host" '{host: $host, checked: true, error: "\($host) is not reachable over ssh"}'
			return
		fi
		active=$(ssh -o BatchMode=yes "$ssh_target" readlink -f /run/current-system)
	else
		active=$(readlink -f "$profile")
	fi
	builds=$(sed -nE 's/^these ([0-9]+) derivations will be built.*/\1/p; s/^this derivation will be built.*/1/p' "$err")
	fetches=$(sed -nE 's/^these ([0-9]+) paths will be fetched.*/\1/p; s/^this path will be fetched.*/1/p' "$err")
	rm -f "$err"

	jq -cn --arg host "$host" --argjson upToDate "$([ "$generation" = "$active" ] && echo true || echo false)" \
		--argjson toBuild "${builds:-0}" --argjson toFetch "${fetches:-0}" \
		'{host: $host, checked: true, upToDate: $upToDate, toBuild: $toBuild, toFetch: $toFetch, error: ""}'
}

build() {
	local host=$1 started=$SECONDS cancelled=0 raw fifo child reader status error ssh_target
	local -a rebuild=(home-manager switch --flake "$flake_dir#$hms_target" -b backup)

	if [ -n "$host" ]; then
		if ! ssh_target=$(resolve_ssh_target "$host"); then
			emit_final failed 0 "$host is not reachable over ssh"
			return 1
		fi
		rebuild=(nixos-rebuild switch --flake "$flake_dir#$host" --target-host "$ssh_target")
		command -v nixos-rebuild >/dev/null || rebuild=(nix run nixpkgs#nixos-rebuild -- "${rebuild[@]:1}")
	elif is_nixos; then
		export SUDO_ASKPASS="${SUDO_ASKPASS:-$SSH_ASKPASS}"
		export NIX_SUDOOPTS="-A"
		rebuild=(nixos-rebuild switch --sudo --flake "$flake_dir#$nixos_target")
	fi

	raw=$(mktemp)
	fifo=$(mktemp -u)
	mkfifo "$fifo"
	trap 'rm -f "$raw" "$fifo"' EXIT
	trap 'cancelled=1; kill -TERM -- "-$child" 2>/dev/null' TERM INT

	setsid "${rebuild[@]}" --log-format internal-json -v >"$fifo" 2>&1 &
	child=$!

	tee "$raw" <"$fifo" | jq -cn --unbuffered -R "$progress_program" &
	reader=$!

	wait "$child"
	status=$?
	while kill -0 "$child" 2>/dev/null; do
		wait "$child"
		status=$?
	done
	wait "$reader"

	mkdir -p "$(dirname "$log_file")"
	jq -Rr "$log_program" "$raw" | sed 's/\x1b\[[0-9;]*m//g' >"$log_file"

	if [ "$cancelled" = 1 ]; then
		emit_final cancelled $((SECONDS - started)) ""
	elif [ "$status" = 0 ]; then
		emit_final done $((SECONDS - started)) ""
	else
		error=$(jq -Rr "$failure_program" "$raw" | sed 's/\x1b\[[0-9;]*m//g' | tail -n 6)
		emit_final failed $((SECONDS - started)) "$error"
		return 1
	fi
}

diff() {
	exec alacritty --class nixbuild-diff --working-directory "$flake_dir" -e omnidiff --review
}

edit() {
	exec alacritty --class nixbuild-edit --working-directory "$flake_dir" \
		-e bash -ic 'exec ${EDITOR:-nvim} .'
}

log() {
	if [ ! -s "$log_file" ]; then
		notify-send "nixbuild" "No build log yet"
		return 1
	fi
	exec alacritty --class nixbuild-log -e less -R +G "$log_file"
}

toggle() {
	qs ipc -p "$quickshell_config" call nixbuild toggle &>/dev/null && return
	start && qs ipc -p "$quickshell_config" call nixbuild toggle
}

start() {
	systemd-run --user --scope --quiet qs -p "$quickshell_config" --no-duplicate -d
}

parse() {
	jq -cn --unbuffered -R "$progress_program"
}

case "$1" in
info) info "$2" ;;
check) check "$2" ;;
build) build "$2" ;;
diff) diff ;;
log) log ;;
edit) edit ;;
toggle) toggle ;;
start) start ;;
parse) parse ;;
*)
	echo "usage: nixbuild info|check|build [host] | diff|log|edit|toggle|start|parse" >&2
	exit 2
	;;
esac
